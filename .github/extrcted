name: 🤖 Auto-Fix Worker

on:
  # Triggered by the head-worker via workflow_dispatch
  workflow_dispatch:
    inputs:
      action:
        description: 'Action for the worker to perform'
        required: true
        default: 'poll'
        type: choice
        options:
          - poll           # Standard poll cycle
          - reinstall-deps # Full npm ci + cache bust
          - lint-fix       # ESLint auto-fix and commit
          - night-patrol   # Deep diagnostic scan
          - health-check   # Run health checks and report

      run_id:
        description: 'Target GitHub Actions run ID (optional)'
        required: false
        type: string

      workflow_file:
        description: 'Workflow file to target (optional)'
        required: false
        default: 'expo-apk.yml'
        type: string

  # Also runs on a schedule for proactive polling
  schedule:
    - cron: '*/30 * * * *'   # Every 30 minutes (standard poll)
    - cron: '0 2 * * *'      # 02:00 EDT — Night Patrol

  # React to failed workflow runs automatically
  workflow_run:
    workflows: ['🚀 Expo APK Build']
    types: [completed]

concurrency:
  group: auto-fix-worker
  cancel-in-progress: false

env:
  NODE_VERSION: '20'
  GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
  EXPO_TOKEN:   ${{ secrets.EXPO_TOKEN }}

jobs:
  # ── Dispatch Router ─────────────────────────────────────────────────────────
  route:
    name: 🔀 Route Action
    runs-on: ubuntu-latest
    outputs:
      action: ${{ steps.resolve.outputs.action }}

    steps:
      - name: Resolve action
        id: resolve
        run: |
          # Determine action based on trigger
          if [[ "${{ github.event_name }}" == "workflow_run" ]]; then
            CONCLUSION="${{ github.event.workflow_run.conclusion }}"
            if [[ "$CONCLUSION" == "failure" ]]; then
              echo "action=poll" >> $GITHUB_OUTPUT
            else
              echo "action=skip" >> $GITHUB_OUTPUT
            fi
          elif [[ "${{ github.event_name }}" == "schedule" ]]; then
            # Detect night patrol cron (02:00)
            HOUR=$(date -u +%H)
            if [[ "$HOUR" == "06" ]]; then   # 02:00 EDT = 06:00 UTC
              echo "action=night-patrol" >> $GITHUB_OUTPUT
            else
              echo "action=poll" >> $GITHUB_OUTPUT
            fi
          else
            echo "action=${{ github.event.inputs.action || 'poll' }}" >> $GITHUB_OUTPUT
          fi

  # ── Standard Poll ───────────────────────────────────────────────────────────
  poll:
    name: 🔍 Poll & Heal
    runs-on: ubuntu-latest
    needs: route
    if: needs.route.outputs.action == 'poll'

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js ${{ env.NODE_VERSION }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'
          cache-dependency-path: auto-fix-worker/package-lock.json

      - name: Install worker dependencies
        working-directory: auto-fix-worker
        run: npm ci --prefer-offline

      - name: Configure worker environment
        working-directory: auto-fix-worker
        run: |
          cat > .env << EOF
          GITHUB_TOKEN=${{ secrets.GITHUB_TOKEN }}
          GITHUB_OWNER=${{ github.repository_owner }}
          GITHUB_REPO=${{ github.event.repository.name }}
          EXPO_TOKEN=${{ secrets.EXPO_TOKEN }}
          WORKER_POLL_INTERVAL_MS=0
          WORKER_MAX_RETRIES=3
          LOG_LEVEL=info
          LOG_DIR=./logs
          NOTIFY_WEBHOOK_URL=${{ secrets.SLACK_WEBHOOK_URL }}
          NOTIFY_ON_FIX=true
          NOTIFY_ON_FAILURE=true
          EOF

      - name: Create logs directory
        working-directory: auto-fix-worker
        run: mkdir -p logs

      - name: Run single poll cycle
        working-directory: auto-fix-worker
        run: node -e "require('./src/head-worker').pollOnce().then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})"
        timeout-minutes: 15

      - name: Upload worker logs
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: worker-logs-${{ github.run_number }}
          path: auto-fix-worker/logs/
          retention-days: 14

  # ── Reinstall Dependencies ───────────────────────────────────────────────────
  reinstall-deps:
    name: 📦 Reinstall Dependencies
    runs-on: ubuntu-latest
    needs: route
    if: needs.route.outputs.action == 'reinstall-deps'

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.PAT_TOKEN || secrets.GITHUB_TOKEN }}

      - name: Setup Node.js ${{ env.NODE_VERSION }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}

      - name: Remove lock file and node_modules
        working-directory: app
        run: |
          rm -f package-lock.json
          rm -rf node_modules

      - name: Fresh install
        working-directory: app
        run: npm install

      - name: Commit updated lock file
        working-directory: app
        run: |
          git config user.name  "J-Roc OS Bot"
          git config user.email "bot@jrocos.io"
          git add package-lock.json
          git diff --staged --quiet || git commit -m "fix(deps): regenerate package-lock.json [auto-fix]"
          git push

  # ── Lint Auto-Fix ────────────────────────────────────────────────────────────
  lint-fix:
    name: 🧹 Lint Auto-Fix
    runs-on: ubuntu-latest
    needs: route
    if: needs.route.outputs.action == 'lint-fix'

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.PAT_TOKEN || secrets.GITHUB_TOKEN }}

      - name: Setup Node.js ${{ env.NODE_VERSION }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'
          cache-dependency-path: app/package-lock.json

      - name: Install dependencies
        working-directory: app
        run: npm ci --prefer-offline

      - name: Run ESLint with auto-fix
        working-directory: app
        run: npx eslint . --ext .ts,.tsx --fix || true

      - name: Commit lint fixes
        working-directory: app
        run: |
          git config user.name  "J-Roc OS Bot"
          git config user.email "bot@jrocos.io"
          git add -A
          git diff --staged --quiet || git commit -m "style: auto-fix ESLint violations [auto-fix]"
          git push

      - name: Verify lint passes after fix
        working-directory: app
        run: npx eslint . --ext .ts,.tsx --max-warnings 0

  # ── Night Patrol ─────────────────────────────────────────────────────────────
  night-patrol:
    name: 🌙 Night Patrol
    runs-on: ubuntu-latest
    needs: route
    if: needs.route.outputs.action == 'night-patrol'

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js ${{ env.NODE_VERSION }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'
          cache-dependency-path: auto-fix-worker/package-lock.json

      - name: Install worker dependencies
        working-directory: auto-fix-worker
        run: npm ci --prefer-offline

      - name: Configure worker environment
        working-directory: auto-fix-worker
        run: |
          cat > .env << EOF
          GITHUB_TOKEN=${{ secrets.GITHUB_TOKEN }}
          GITHUB_OWNER=${{ github.repository_owner }}
          GITHUB_REPO=${{ github.event.repository.name }}
          EXPO_TOKEN=${{ secrets.EXPO_TOKEN }}
          LOG_LEVEL=info
          LOG_DIR=./logs
          NOTIFY_WEBHOOK_URL=${{ secrets.SLACK_WEBHOOK_URL }}
          NOTIFY_ON_FIX=true
          NOTIFY_ON_FAILURE=true
          EOF

      - name: Create logs directory
        working-directory: auto-fix-worker
        run: mkdir -p logs

      - name: Run Night Patrol
        working-directory: auto-fix-worker
        run: node -e "require('./src/head-worker').nightPatrol().then(r=>{console.log(JSON.stringify(r,null,2));process.exit(0)}).catch(e=>{console.error(e);process.exit(1)})"
        timeout-minutes: 20

      - name: Upload patrol logs
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: night-patrol-logs-${{ github.run_number }}
          path: auto-fix-worker/logs/
          retention-days: 30

  # ── Health Check ─────────────────────────────────────────────────────────────
  health-check:
    name: 🏥 Health Check
    runs-on: ubuntu-latest
    needs: route
    if: needs.route.outputs.action == 'health-check'

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Run health check script
        working-directory: auto-fix-worker
        run: bash scripts/health-check.sh

      - name: App dependency audit
        working-directory: app
        run: npm audit --audit-level=high || true

      - name: Worker dependency audit
        working-directory: auto-fix-worker
        run: npm audit --audit-level=high || true

name: 🚀 Expo APK Build

on:
  push:
    branches: [main, develop]
    paths:
      - 'app/**'
      - '.github/workflows/expo-apk.yml'
  pull_request:
    branches: [main]
    paths:
      - 'app/**'
  workflow_dispatch:
    inputs:
      profile:
        description: 'EAS build profile'
        required: false
        default: 'preview'
        type: choice
        options: [preview, production, development]
      platform:
        description: 'Target platform'
        required: false
        default: 'android'
        type: choice
        options: [android, ios, all]

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

env:
  NODE_VERSION: '20'
  EXPO_TOKEN: ${{ secrets.EXPO_TOKEN }}

jobs:
  # ── 1. Validate ─────────────────────────────────────────────────────────────
  validate:
    name: 🔍 Validate & Lint
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: app

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js ${{ env.NODE_VERSION }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'
          cache-dependency-path: app/package-lock.json

      - name: Install dependencies
        run: npm ci --prefer-offline

      - name: TypeScript check
        run: npx tsc --noEmit

      - name: ESLint
        run: npm run lint -- --max-warnings 0

      - name: Run tests
        run: npm test -- --ci --coverage --passWithNoTests

      - name: Upload coverage
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: coverage-report
          path: app/coverage/
          retention-days: 7

  # ── 2. Build (Preview APK) ──────────────────────────────────────────────────
  build-preview:
    name: 🔨 Build APK (Preview)
    runs-on: ubuntu-latest
    needs: validate
    if: github.event_name != 'pull_request'
    defaults:
      run:
        working-directory: app

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js ${{ env.NODE_VERSION }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'
          cache-dependency-path: app/package-lock.json

      - name: Install dependencies
        run: npm ci --prefer-offline

      - name: Setup EAS CLI
        uses: expo/expo-github-action@v8
        with:
          eas-version: latest
          token: ${{ secrets.EXPO_TOKEN }}

      - name: Build preview APK
        id: build
        run: |
          eas build \
            --platform ${{ github.event.inputs.platform || 'android' }} \
            --profile ${{ github.event.inputs.profile || 'preview' }} \
            --non-interactive \
            --json \
            --no-wait \
            | tee build-output.json
          echo "build_id=$(jq -r '.[0].id' build-output.json)" >> $GITHUB_OUTPUT

      - name: Wait for build completion
        run: |
          eas build:view ${{ steps.build.outputs.build_id }} --json \
            | jq '.status'

      - name: Get APK download URL
        id: apk
        run: |
          URL=$(eas build:view ${{ steps.build.outputs.build_id }} --json | jq -r '.artifacts.buildUrl')
          echo "url=$URL" >> $GITHUB_OUTPUT
          echo "📦 APK URL: $URL"

      - name: Upload build metadata
        uses: actions/upload-artifact@v4
        with:
          name: build-metadata
          path: app/build-output.json
          retention-days: 30

      - name: Create GitHub release (main only)
        if: github.ref == 'refs/heads/main'
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v5.0.${{ github.run_number }}
          name: "J-Roc OS v5.0.${{ github.run_number }}"
          body: |
            ## 🚀 J-Roc OS 5.0 Build ${{ github.run_number }}

            **APK Download:** ${{ steps.apk.outputs.url }}
            **Commit:** ${{ github.sha }}
            **Branch:** ${{ github.ref_name }}
            **Built:** ${{ github.run_id }}

            ---
            *Auto-generated by J-Roc OS CI pipeline*
          draft: false
          prerelease: ${{ github.ref != 'refs/heads/main' }}
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

  # ── 3. Production AAB ───────────────────────────────────────────────────────
  build-production:
    name: 🏭 Build AAB (Production)
    runs-on: ubuntu-latest
    needs: validate
    if: |
      github.ref == 'refs/heads/main' &&
      github.event_name == 'workflow_dispatch' &&
      github.event.inputs.profile == 'production'
    defaults:
      run:
        working-directory: app

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js ${{ env.NODE_VERSION }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'
          cache-dependency-path: app/package-lock.json

      - name: Install dependencies
        run: npm ci --prefer-offline

      - name: Setup EAS CLI
        uses: expo/expo-github-action@v8
        with:
          eas-version: latest
          token: ${{ secrets.EXPO_TOKEN }}

      - name: Build production AAB
        run: |
          eas build \
            --platform android \
            --profile production \
            --non-interactive

      - name: Notify success
        if: success()
        run: echo "✅ Production AAB build complete!"

